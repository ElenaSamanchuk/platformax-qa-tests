{
  "name": "platformax-qa-tests",
  "private": true,
  "description": "Shared QA contracts, fixtures and feature regression suites",
  "scripts": {
    "setup": "npm install && npx playwright install chromium",
    "test": "playwright test",
    "test:headed": "HEADED=1 playwright test",
    "report": "playwright show-report report",
    "test:unit": "node --test unit/*.test.js",
    "test:list": "playwright test --list",
    "test:live": "playwright test tests/live-rooms.spec.js",
    "test:referral": "playwright test tests/referral.spec.js",
    "test:smoke": "playwright test -g \"S-1 окружение|H-1 старая|Вход:|RF-core desktop.*RF-[123] \""
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
